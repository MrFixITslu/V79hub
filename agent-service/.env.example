NODE_ENV=development
PORT=3055

# Model provider. Ollama is the production default.
V79_AGENT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_OPENAI_BASE_URL=http://ollama:11434/v1
OLLAMA_AGENT_MODEL=qwen2.5:1.5b
OLLAMA_REQUEST_TIMEOUT_MS=60000
OLLAMA_PREWARM_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=-1
OLLAMA_REQUEST_TIMEOUT_MS=90000
OLLAMA_PREWARM_TIMEOUT_MS=120000
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_TOKENS=80
OLLAMA_CONTEXT_SIZE=2048
OLLAMA_API_KEY=ollama-local

# Optional hosted fallback. Only used when V79_AGENT_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-sol

# Optional development override. Production reads the deployment-generated token file.
V79_AGENT_API_TOKEN=
V79_AGENT_TOKEN_FILE=/run/secrets/v79-agent-token

# Health/status endpoints the read-only agent is allowed to check.
# Add the real internal Docker URLs as each app is connected.
V79_HUB_HEALTH_URL=http://v79-hub:3040/api/health
V79_HUB_AGENT_SNAPSHOT_URL=http://v79-hub:3040/internal/agent/snapshot
V79_WEBSITE_HEALTH_URL=
V79_LASERTAG_HEALTH_URL=
V79_MARKETING_HEALTH_URL=
V79_POS_HEALTH_URL=
V79_TIQUET_HEALTH_URL=
V79_FFPRO_HEALTH_URL=
V79_ACADEMY_HEALTH_URL=
V79_GAMES_HEALTH_URL=